{
  "name": "pomodoro-timer",
  "version": "1.0.0",
  "description": "桌面番茄钟",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win portable"
  },
  "build": {
    "appId": "com.pomodoro.timer",
    "productName": "Pomodoro",
    "directories": { "output": "dist" },
    "win": {
      "target": "portable",
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "Pomodoro.exe"
    }
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  }
}
